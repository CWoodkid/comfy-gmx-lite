#!/bin/bash
# Runs once, while Binder (or repo2docker) builds the online copy, after the
# software in environment.yml is installed. It runs in this repository's
# folder, which becomes the home folder of everyone who opens the online copy.
set -euo pipefail

# 1. Tell Jupyter about the editor, with the small plug-in in jupyter-proxy/.
#    The first time somebody opens <session address>/comfygmx/, Jupyter starts
#    binder/launch.py with a free port and passes the page through to it. The
#    plug-in also puts a "Comfy-gmx lite" tile in JupyterLab's launcher.
#    (A settings file in jupyter_server_config.d/ does not work for this:
#    Jupyter reads that folder only to learn which extensions to switch on.)
python3 -m pip install --no-deps --no-build-isolation ./binder/jupyter-proxy

# 2. Check the two tutorials still fit the blocks this version has. A
#    failure here stops the build, which is better found now than in front of
#    a class.
python3 -m comfygmx --data-dir "$HOME/.comfy-gmx-lite" validate \
    workflows/tutorials/gmx-01-lysozyme-in-water.json \
    workflows/tutorials/workshop-01-an-ice-cube-melting.json

# 3. Download, now, what the tutorials would download when they run: the
#    lysozyme structure and CHARMM36. (The ice tutorial builds its own
#    crystal and needs nothing.) Each block keeps its result, and a block
#    whose settings have not changed is not run again, so in the online copy
#    these blocks finish at once and nobody depends on those websites during
#    a class. If a site is down right now, the tutorial simply downloads it
#    when it runs.
python3 -m comfygmx --data-dir "$HOME/.comfy-gmx-lite" run \
    workflows/tutorials/gmx-01-lysozyme-in-water.json --only ff --only fetch \
    --label "downloaded while the online copy was built" \
  || echo "postBuild: the lysozyme downloads failed; the tutorial will fetch them itself"
