; Lysozyme tutorial, as published. 100 ps at 298 K in a box of fixed size: new random speeds at the start, the protein held in place by springs.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
title      = Lysozyme NVT equilibration
integrator = md
dt         = 0.002
nsteps     = 50000

; ---- Output control ----------------------------------
nstxout   = 2500
nstvout   = 2500
nstlog    = 2500
nstenergy = 2500

; ---- Neighbour searching -----------------------------
cutoff-scheme = Verlet
nstlist       = 10
ns-type       = grid
pbc           = xyz

; ---- Electrostatics ----------------------------------
coulombtype    = PME
rcoulomb       = 1.2
fourierspacing = 0.16
pme-order      = 4

; ---- Van der Waals -----------------------------------
vdw-modifier = force-switch
rvdw         = 1.2
rvdw-switch  = 1.0
dispcorr     = No

; ---- Temperature coupling ----------------------------
tcoupl  = V-rescale
tc-grps = System
tau-t   = 1.0
ref-t   = 298

; ---- Pressure coupling -------------------------------
pcoupl = no

; ---- Velocity generation -----------------------------
gen-vel  = yes
gen-temp = 298
gen-seed = -1

; ---- Bonds -------------------------------------------
constraints          = h-bonds
constraint-algorithm = lincs
continuation         = no
lincs-order          = 4
lincs-iter           = 1

; ---- Restraints / pulling ----------------------------
define = -DPOSRES
