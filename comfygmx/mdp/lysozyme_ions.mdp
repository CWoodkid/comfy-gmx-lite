; Lysozyme tutorial, verbatim: throwaway minimisation used only to build the tpr genion needs (plain cutoff electrostatics).
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = steep
nsteps     = 50000
emtol      = 1000.0
emstep     = 0.01

; ---- Neighbour searching -----------------------------
cutoff-scheme = Verlet
nstlist       = 1
ns-type       = grid
pbc           = xyz

; ---- Electrostatics ----------------------------------
coulombtype = cutoff
rcoulomb    = 1.0

; ---- Van der Waals -----------------------------------
rvdw = 1.0
