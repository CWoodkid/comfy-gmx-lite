; Lysozyme tutorial, as published. Energy minimisation: moves the atoms until the strongest force on any atom is below 1000 kJ/mol/nm.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = steep
nsteps     = 50000
emtol      = 1000.0
emstep     = 0.01

; ---- Neighbour searching -----------------------------
cutoff-scheme = Verlet
nstlist       = 1
ns-type       = grid
pbc           = xyz

; ---- Electrostatics ----------------------------------
coulombtype = PME
rcoulomb    = 1.0

; ---- Van der Waals -----------------------------------
rvdw = 1.0
