; NPT equilibration, C-rescale barostat, restraints still on.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = md
dt         = 0.002
nsteps     = 50000
comm-mode  = Linear
nstcomm    = 100

; ---- Output control ----------------------------------
nstxout                = 0
nstvout                = 0
nstfout                = 0
nstlog                 = 1000
nstenergy              = 1000
nstxout-compressed     = 1000
compressed-x-precision = 1000

; ---- Neighbour searching -----------------------------
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
verlet-buffer-tolerance = 0.005

; ---- Electrostatics ----------------------------------
coulombtype    = PME
rcoulomb       = 1.2
fourierspacing = 0.12
pme-order      = 4

; ---- Van der Waals -----------------------------------
vdwtype      = cutoff
vdw-modifier = force-switch
rvdw         = 1.2
rvdw-switch  = 1.0
dispcorr     = no

; ---- Temperature coupling ----------------------------
tcoupl  = V-rescale
tc-grps = Protein Non-Protein
tau-t   = 0.1 0.1
ref-t   = 310 310

; ---- Pressure coupling -------------------------------
pcoupl           = C-rescale
pcoupltype       = isotropic
tau-p            = 5.0
compressibility  = 4.5e-5
ref-p            = 1.0
refcoord-scaling = com

; ---- Velocity generation -----------------------------
gen-vel = no

; ---- Bonds -------------------------------------------
constraints          = h-bonds
constraint-algorithm = lincs
continuation         = yes
lincs-order          = 4
lincs-iter           = 1

; ---- Restraints / pulling ----------------------------
define = -DPOSRES
