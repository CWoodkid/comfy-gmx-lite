; Lysozyme tutorial, verbatim: 500 ps restrained NPT, C-rescale barostat.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
title      = Lysozyme NPT equilibration
integrator = md
dt         = 0.002
nsteps     = 250000

; ---- Output control ----------------------------------
nstxout   = 500
nstvout   = 500
nstlog    = 500
nstenergy = 500

; ---- Neighbour searching -----------------------------
cutoff-scheme = Verlet
nstlist       = 10
ns-type       = grid
pbc           = xyz

; ---- Electrostatics ----------------------------------
coulombtype    = PME
rcoulomb       = 1.2
fourierspacing = 0.16
pme-order      = 4

; ---- Van der Waals -----------------------------------
vdw-modifier = force-switch
rvdw         = 1.2
rvdw-switch  = 1.0
dispcorr     = No

; ---- Temperature coupling ----------------------------
tcoupl  = V-rescale
tc-grps = System
tau-t   = 1.0
ref-t   = 298

; ---- Pressure coupling -------------------------------
pcoupl           = C-rescale
pcoupltype       = isotropic
tau-p            = 5.0
compressibility  = 4.5e-5
ref-p            = 1.0
refcoord-scaling = com

; ---- Velocity generation -----------------------------
gen-vel = no

; ---- Bonds -------------------------------------------
constraints          = h-bonds
constraint-algorithm = lincs
continuation         = yes
lincs-order          = 4
lincs-iter           = 1

; ---- Restraints / pulling ----------------------------
define = -DPOSRES
