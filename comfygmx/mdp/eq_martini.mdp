; Martini 3 equilibration: 5 fs steps, semiisotropic C-rescale, backbone restrained.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = md
dt         = 0.005
nsteps     = 200000
comm-mode  = Linear
nstcomm    = 100

; ---- Output control ----------------------------------
nstxout                = 0
nstvout                = 0
nstfout                = 0
nstlog                 = 1000
nstenergy              = 1000
nstxout-compressed     = 1000
compressed-x-precision = 1000

; ---- Neighbour searching -----------------------------
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
verlet-buffer-tolerance = 0.005

; ---- Electrostatics ----------------------------------
coulombtype      = reaction-field
coulomb-modifier = Potential-shift-verlet
rcoulomb         = 1.1
epsilon-r        = 15
epsilon-rf       = 0

; ---- Van der Waals -----------------------------------
vdwtype      = cutoff
vdw-modifier = Potential-shift-verlet
rvdw         = 1.1
dispcorr     = no

; ---- Temperature coupling ----------------------------
tcoupl  = V-rescale
tc-grps = PROTEIN MEMBRANE SOLVENT
tau-t   = 1.0 1.0 1.0
ref-t   = 310 310 310

; ---- Pressure coupling -------------------------------
pcoupl           = C-rescale
pcoupltype       = semiisotropic
tau-p            = 12.0
compressibility  = 3e-4 3e-4
ref-p            = 1.0 1.0
refcoord-scaling = all

; ---- Velocity generation -----------------------------
gen-vel  = yes
gen-temp = 310
gen-seed = -1

; ---- Bonds -------------------------------------------
constraints          = none
constraint-algorithm = Lincs
continuation         = no
lincs-order          = 8
lincs-warnangle      = 90

; ---- Restraints / pulling ----------------------------
define = -DPOSRES -DPOSRES_FC=1000
