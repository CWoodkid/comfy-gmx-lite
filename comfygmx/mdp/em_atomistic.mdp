; Steepest-descent minimisation, PME, force-switched LJ (CHARMM36-style).
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = steep
nsteps     = 50000
emtol      = 1000.0
emstep     = 0.01

; ---- Output control ----------------------------------
nstlog    = 100
nstenergy = 100

; ---- Neighbour searching -----------------------------
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
verlet-buffer-tolerance = 0.005

; ---- Electrostatics ----------------------------------
coulombtype    = PME
rcoulomb       = 1.2
fourierspacing = 0.12
pme-order      = 4

; ---- Van der Waals -----------------------------------
vdwtype      = cutoff
vdw-modifier = force-switch
rvdw         = 1.2
rvdw-switch  = 1.0
dispcorr     = no

; ---- Bonds -------------------------------------------
constraints = none
