; Martini 3 minimisation: reaction field, epsilon_r = 15, small emstep for freshly packed membranes.
; generated by Comfy-gmx

; ---- Run control -------------------------------------
integrator = steep
nsteps     = 10000
emtol      = 100.0
emstep     = 0.001

; ---- Output control ----------------------------------
nstlog    = 100
nstenergy = 100

; ---- Neighbour searching -----------------------------
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
verlet-buffer-tolerance = 0.005

; ---- Electrostatics ----------------------------------
coulombtype      = reaction-field
coulomb-modifier = Potential-shift-verlet
rcoulomb         = 1.1
epsilon-r        = 15
epsilon-rf       = 0

; ---- Van der Waals -----------------------------------
vdwtype      = cutoff
vdw-modifier = Potential-shift-verlet
rvdw         = 1.1
dispcorr     = no

; ---- Bonds -------------------------------------------
constraints = none
